# ── Server ────────────────────────────────────────────────────────────────────
# Порт на хості, який займає контейнер (Nginx Proxy Manager → цей порт).
# Перевір що порт вільний на хості: ss -ltnp | grep <PORT>
HOST_PORT=3300

# ── Auth ──────────────────────────────────────────────────────────────────────
# Токен для API-доступу (CI надсилає результати тестів з цим токеном у заголовку).
# Обов'язковий у production. Згенерувати: openssl rand -hex 32
API_TOKEN=

# Секрет для NextAuth JWT підпису. Обов'язковий.
# Згенерувати: openssl rand -hex 32
AUTH_SECRET=

# Час життя UI-сесії в годинах (default: 8)
UI_AUTH_EXPIRE_HOURS=8

# ── Google OAuth (опційно) ──────────────────────────────────────────────────
# Логін через Google для людей у UI. Вмикається, лише коли задані ОБИДВА:
# ID + SECRET. Співіснує з API_TOKEN (той лишається для CI/скриптів).
# Redirect URI у Google Console: https://<твій-домен>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Домени, яким дозволено вхід через Google (кома-список). Користувачі з цих
# доменів отримують роль viewer (лише перегляд). Порожньо + без admin-емейлів
# = ніхто не пройде (fail-closed).
AUTH_ALLOWED_DOMAINS=example.com
# Емейли з роллю admin (Settings, видалення, тригер автотестів) — кома-список.
# Завжди дозволені незалежно від домену.
AUTH_ADMIN_EMAILS=

# ── Storage ───────────────────────────────────────────────────────────────────
# "fs" — локальний filesystem (volume /app/data). Рекомендовано для початку.
# "s3" — S3-compatible storage (MinIO, AWS S3, etc.)
DATA_STORAGE=fs

# ── Очищення старих даних (опційно) ──────────────────────────────────────────
# RESULT_EXPIRE_DAYS=30
# REPORT_EXPIRE_DAYS=90

# ── S3 (якщо DATA_STORAGE=s3) ────────────────────────────────────────────────
# S3_ENDPOINT=s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_BUCKET=testboard
# S3_USE_SSL=true
# S3_BATCH_SIZE=10

# ── AI Summary (опційно) ─────────────────────────────────────────────────────
# Якщо задано — після генерації репорту з падіннями сервер сам звертається до
# Anthropic і пише короткий AI-розбір (ai-summary.md поруч з index.html).
# Клінові прогони (без падінь) нічого не коштують — LLM не викликається.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Run Autotests (опційно) ──────────────────────────────────────────────────
# Якщо задано всі три — сторінка /run-tests дозволяє тригерити прогін
# автотестів у Drone CI (custom build з параметрами ENVIRONMENT/FUNNEL/TAG).
# DRONE_SERVER=https://drone.example.com
# DRONE_TOKEN=
# DRONE_AUTOTESTS_REPO=owner/autotests

# ── Notifications ────────────────────────────────────────────────────────────
# Публічна адреса сервера — для лінків у Slack/webhook-повідомленнях.
# Канали налаштовуються в UI: Settings → Нотифікації.
# BASE_URL=https://testboard.example.com
